# Copy this file to .env in the project root, then adjust values if needed.

# PostgreSQL connection used by the API and Prisma.
DATABASE_URL="postgresql://samuel_app:samuel_demo_pass@127.0.0.1:5432/samuel_academy?schema=public"

# Separate database used by the automated tests.
TEST_DATABASE_URL="postgresql://samuel_app:samuel_demo_pass@127.0.0.1:5432/samuel_academy_test?schema=public"

# JWT signing secret. Generate a long random string for anything beyond local demo.
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# API port and the public web URL used for CORS.
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Demo mode shows clearly-labelled sample payment instructions and demo logins.
# Set DEMO_MODE="false" for production and define the single admin account below.
DEMO_MODE="true"
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
DEMO_PAYMENT_INSTAPAY="DEMO only - InstaPay alias: 01000000000 (do not send real money)"
DEMO_PAYMENT_EWALLET="DEMO only - Wallet: Vodafone Cash 01000000000 (do not send real money)"

# Private uploads (PDF, MP4, MP3). Keep this outside apps/web/public.
# A relative path is resolved from the API folder; an absolute path is used as-is.
UPLOAD_DIR="apps/api/storage/uploads"
MAX_UPLOAD_BYTES="20971520"
MAX_MEDIA_BYTES="209715200"
